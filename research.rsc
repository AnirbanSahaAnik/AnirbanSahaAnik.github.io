1:["$","main",null,{"id":"main-content","className":"site-container page-shell","children":[["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":"Research"}],["$","h1",null,{"children":"Language systems grounded in evidence and designed around people."}],["$","p",null,{"className":"page-description","children":"My research connects reliable knowledge use, audience adaptation, and rigorous evaluation in high-stakes communication."}]]}],["$","div",null,{"className":"research-themes","children":[["$","article","01",{"className":"research-theme","children":[["$","p",null,{"className":"theme-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Knowledge-grounded generation"}],["$","p",null,{"children":"I build retrieval-augmented generation and knowledge-graph methods that connect LLM outputs to trusted evidence. My work studies multi-agent orchestration, static and dynamic retrieval, evidence selection, and structured biomedical knowledge."}],["$","ul",null,{"className":"topic-list","children":[["$","li","RAG",{"children":"RAG"}],["$","li","Knowledge Graphs",{"children":"Knowledge Graphs"}],["$","li","Evidence Grounding",{"children":"Evidence Grounding"}],["$","li","Multi-Agent LLMs",{"children":"Multi-Agent LLMs"}]]}]]}]]}],["$","article","02",{"className":"research-theme","children":[["$","p",null,{"className":"theme-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Controllable & personalized generation"}],["$","p",null,{"children":"I design generation methods that adapt explanations to readers' health literacy, knowledge, and information needs while preserving factual accuracy. This includes literacy-controlled generation and systems that learn when clarification is worth asking for."}],["$","ul",null,{"className":"topic-list","children":[["$","li","Controllable Generation",{"children":"Controllable Generation"}],["$","li","Personalization",{"children":"Personalization"}],["$","li","Health Literacy",{"children":"Health Literacy"}],["$","li","Reinforcement Learning",{"children":"Reinforcement Learning"}]]}]]}]]}],["$","article","03",{"className":"research-theme","children":[["$","p",null,{"className":"theme-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Evaluation & benchmarking"}],["$","p",null,{"children":"I develop benchmarks, metrics, and human-evaluation protocols for factuality, faithfulness, consistency, and audience alignment. The goal is to measure whether a model is not only fluent, but reliable and useful to the person reading it."}],["$","ul",null,{"className":"topic-list","children":[["$","li","LLM Evaluation",{"children":"LLM Evaluation"}],["$","li","Benchmarks",{"children":"Benchmarks"}],["$","li","Factuality",{"children":"Factuality"}],["$","li","Human Evaluation",{"children":"Human Evaluation"}]]}]]}]]}],["$","article","04",{"className":"research-theme","children":[["$","p",null,{"className":"theme-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Health & crisis communication"}],["$","p",null,{"children":"I apply these methods in settings where communication quality matters: evidence-based responses to health misinformation and timely, consistent responses during crises. These domains motivate the technical questions across my research."}],["$","ul",null,{"className":"topic-list","children":[["$","li","Health Misinformation",{"children":"Health Misinformation"}],["$","li","Crisis Informatics",{"children":"Crisis Informatics"}],["$","li","Responsible AI",{"children":"Responsible AI"}],["$","li","Human-Centered NLP",{"children":"Human-Centered NLP"}]]}]]}]]}]]}],["$","div",null,{"className":"page-cta","children":[["$","p",null,{"children":"Explore the peer-reviewed work behind these research directions."}],["$","$L2",null,{"className":"button primary","href":"/publications","children":"View publications"}]]}]]}]
